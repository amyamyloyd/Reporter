### Component Architecture
```javascript
/**
 * Standard React Component Template
 * Apply 30% comment ratio and error handling patterns
 */
import React, { useState, useEffect } from 'react';

function ComponentName({ requiredProps }) {
  // State management - simple useState only (no Redux/Zustand)
  const [data, setData] = useState(null);
  const [isLoading, setIsLoading] = useState(false);
  const [errorMessage, setErrorMessage] = useState('');
  
  // Use standard error handling pattern in all functions
  const handleOperation = async () => {
    setIsLoading(true);
    try {
      const result = await apiCall();
      setData(result);
    } catch (error) {
      setErrorMessage('Operation failed: ' + error.message);
    } finally {
      setIsLoading(false);
    }
  };

  return (
    // Apply Tailwind standards below
    <div className="standardized-container">
      {/* Component content */}
    </div>
  );
}
```

